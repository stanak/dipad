; ===========================================================================
;  dipad 設定サンプル
;
;  このファイルを dipad.dll (または dinput8.dll) と同じフォルダ = ゲームフォルダに
;  「dipad.ini」という名前で置くと、
;  下記の設定が読み込まれます。ファイルが無い場合はすべてデフォルト値です。
;
;  非想天則 + L2/R2 を使う場合は、下の [AxisToButton] のコメントを外せば
;  そのまま使えます。
; ===========================================================================

[General]

; POV(十字キー) を X/Y 軸入力にどう反映するか
;   pov_priority   : POV が押されている方向だけ X/Y を上書き (デフォルト)
;                    → スティック・十字キーの両方が機能する。通常はこれ
;   pov_only       : 常に POV で X/Y を上書き (スティックは X/Y に影響しない)
;   stick_priority : スティックが中央付近のときだけ POV を使う
PovMode = pov_priority

; POV を押したときに X/Y 軸へ書き込む大きさ。
; ゲームが DIPROP_RANGE で軸範囲を指定している場合は、自動的にそちらが優先されます。
AxisValue = 1000

; スティックが「中央」とみなされるしきい値 (絶対値、DI 標準レンジ)。
; PovMode = stick_priority のときに参照されます。
StickDeadzone = 200

; 1 にすると %LOCALAPPDATA%\dipad\dipad.log に動作ログを出力します。
; 動作確認やトラブルシュート用。常用時は 0 推奨。
EnableLog = 0

; X / Y を個別に書き換え抑止したい場合は 0 にしてください。
; (例: 上下だけ POV を反映したい → OverrideLX = 0)
OverrideLX = 1
OverrideLY = 1

; 通常 POV は1個目だけ使います。複数 POV を持つコントローラで別を読みたい
; ときに 0〜3 で指定してください。
PovIndex = 0

; 1 にすると、コントローラの全軸 / POV / ボタン状態の変化を dipad.log に出します。
; ※ 必ず EnableLog = 1 と併用してください。
; L2/R2 などのトリガーがどの軸名で上がってくるかを調べるための診断機能です。
; 確認が済んだら 0 に戻すことを推奨 (ログ量が多くなります)。
DebugAxisDump = 0


; ===========================================================================
;  [AxisToButton]
;
;  L2 / R2 のようなアナログトリガーを、ボタンしか受け付けないゲーム
;  (非想天則など) でも使えるようにするためのブリッジ機能。
;
;  指定した軸が閾値を超えている間、指定したボタン番号を ON にし続けます。
;  形式: AxisButtonN = <軸名>:<符号>:<閾値>:<ボタン番号>
;
;    軸名      : x / y / z / rx / ry / rz / slider0 / slider1
;                (頭の "l" は付けても付けなくても OK)
;    符号      : + (正方向で発火) / - (負方向で発火)
;    閾値      : 軸の絶対値。ゲームが DIPROP_RANGE をかける場合はその範囲内
;                での数値になります。値がわからない場合はまず DebugAxisDump=1
;                で実値を確認してください。
;    ボタン番号: 0〜127 (ゲームが使うデータフォーマットのボタン数まで。
;                標準フォーマットでは 32 または 128)
;
;  16 個まで登録可能 (AxisButton1 〜 AxisButton16)。
;  未指定の AxisButtonN は無視されます。
; ===========================================================================

[AxisToButton]

; ---------------------------------------------------------------------------
; 非想天則 + Xbox / Vader 4 Pro 系コントローラ向け推奨設定
;
; これらのコントローラは DInput モードで L2/R2 が Z 軸を共有しています。
;   L2 → Z 軸の負方向 (Z ≈ -1000 付近)
;   R2 → Z 軸の正方向 (Z ≈ +1000 付近)
;
; 天則は DIPROP_RANGE = ±1000 なので閾値 500 で半押し以上を検出します。
; ボタン 10/11 は天則のデフォルトキー割り当てでも未使用なので衝突しません。
; ---------------------------------------------------------------------------
; AxisButton1 = z:+:500:10   ; R2 → BUTTON 10
; AxisButton2 = z:-:500:11   ; L2 → BUTTON 11
